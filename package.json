{
    "name": "dark-glass",
    "version": "0.0.0-development",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/felipevlourenco/dark-glass.git"
    },
    "homepage": "https://felipevlourenco.github.io/dark-glass/",
    "bugs": {
        "url": "https://github.com/felipevlourenco/dark-glass/issues"
    },
    "description": "A React component library and dashboard kit: frosted glass panels, pill controls, two themes.",
    "keywords": [
        "react",
        "ui",
        "components",
        "design-system",
        "dashboard",
        "glassmorphism"
    ],
    "sideEffects": [
        "**/*.css",
        "./dist/index.js",
        "./dist/index.cjs"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./dist/dark-glass.css"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json --noEmit false --emitDeclarationOnly --declaration --outDir dist && node scripts/strip-css-imports.mjs",
        "dev": "vite build --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "visual": "playwright test",
        "visual:update": "playwright test --update-snapshots",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "lint": "oxlint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build",
        "prepare": "husky"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@playwright/test": "^1.65.0",
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/react-vite": "10.6.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "axe-core": "4.14.0",
        "http-server": "^14.1.1",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.90.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "semantic-release": "^25.0.9",
        "storybook": "10.6.5",
        "storybook-addon-pseudo-states": "^10.6.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@12.11.2"
}
